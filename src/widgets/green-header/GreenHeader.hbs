<header class="green-header">
    <div class="header-container">
        <a href="/" class="logo-link">
            <img src="{{logo}}" alt="Logo" class="logo-image">
        </a>

        {{#if user}}
        <div class="header-user-pill-wrapper">
            <div class="header-user-pill">
                {{#if user.avatarUrl}}
                    <img class="header-user-pill__avatar" src="{{user.avatarUrl}}" alt="" />
                {{else}}
                    <span class="header-user-pill__avatar header-user-pill__avatar--default">{{user.initials}}</span>
                {{/if}}
                <span class="header-user-pill__name">{{user.username}}</span>
            </div>
            <div class="header-user-dropdown">
                <button class="header-user-dropdown__item" data-action="profile">Профиль</button>
                <button class="header-user-dropdown__item header-user-dropdown__item--danger" data-action="logout">Выйти из аккаунта</button>
            </div>
        </div>
        {{else}}
        <div class="header-buttons">
            {{#each buttons}}
                <button class="base-btn  {{this.class}}" data-action="{{this.action}}">
                    {{this.text}}
                </button>
            {{/each}}
        </div>
        {{/if}}
    </div>
</header>