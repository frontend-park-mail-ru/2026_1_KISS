<header class="green-header">
    <div class="header-container">
        <a href="/" class="logo-link">
            <img src="{{logo}}" alt="Logo" class="logo-image">
        </a>

        {{#if user}}
        <div class="header-user-pill">
            <svg class="header-user-pill__icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                <circle cx="12" cy="7" r="4"/>
            </svg>
            <span class="header-user-pill__name">{{user.username}}</span>
        </div>
        {{else}}
        <div class="header-buttons">
            {{#each buttons}}
                <button class="base-btn  {{this.class}}" data-action="{{this.action}}">
                    {{this.text}}
                </button>
            {{/each}}
        </div>
        {{/if}}
    </div>
</header>