<div class="input-wrapper {{#if error}}input-wrapper_error{{/if}} {{#if disabled}}input-wrapper_disabled{{/if}}">
    <div class="input-field-container">
        <input
                type="{{type}}"
                id="{{id}}"
                value="{{value}}"
                placeholder="{{placeholder}}"
                class="input-field"
            {{#if required}}required{{/if}}
            {{#if pattern}}pattern="{{pattern}}"{{/if}}
            {{#if minlength}}minlength="{{minlength}}"{{/if}}
            {{#if maxlength}}maxlength="{{maxlength}}"{{/if}}
        />
        {{#if isPassword}}
            <button type="button" class="toggle-password-btn" aria-label="Показать пароль">
                <img class="eye-icon eye-icon_closed" src="/images/eye-closed.svg" alt="Показать пароль"/>
                <img class="eye-icon eye-icon_open eye-icon_hidden" src="/images/eye-open.svg" alt="Скрыть пароль"/>
            </button>
        {{/if}}
    </div>

    <span class="input-error-message">{{error}}</span>

<!--    {{#if hint}}-->
<!--        <span class="input-hint">{{hint}}</span>-->
<!--    {{/if}}-->
</div>