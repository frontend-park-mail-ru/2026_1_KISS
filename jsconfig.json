{
    "compilerOptions": {
        "checkJs": true,
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "node",
        "strict": true,
        "noEmit": true,
        "lib": ["ES2022", "DOM", "DOM.Iterable"]
    },
    "include": ["src/**/*.js", "build/**/*.js"],
    "exclude": ["node_modules", "dist"]
}
