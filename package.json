{
    "name": "KISS Сolab",
    "version": "0.0.1",
    "description": "Платформа для написания и выполнения кода на языке Python прямо в браузере",
    "main": "test_server/index.js",
    "scripts": {
        "test": "npx playwright test",
        "test:headed": "npx playwright test --headed",
        "prestart": "npm run compile:templates",
        "start": "DEBUG=* && node test_server/index.js",
        "compile:templates": "chmod +x compile-templates.sh && ./compile-templates.sh",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write \"src/**/*.js\" \"test_server/**/*.js\" \".prettierrc.js\"",
        "format:check": "prettier --check \"src/**/*.js\" \"test_server/**/*.js\" \".prettierrc.js\""
    },
    "license": "ISC",
    "dependencies": {
        "body-parser": "^2.2.0",
        "cookie-parser": "^1.4.7",
        "debug": "^4.3.7",
        "dompurify": "^3.0.6",
        "express": "5.1.0",
        "handlebars": "^4.7.8",
        "morgan": "^1.10.1",
        "uuid": "^13.0.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.58.2",
        "eslint": "^10.0.3",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.4.0",
        "http-proxy-middleware": "^3.0.5",
        "prettier": "^3.5.1"
    }
}
