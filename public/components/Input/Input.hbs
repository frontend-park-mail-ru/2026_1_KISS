<div class="input-wrapper {{#if error}}input-wrapper_error{{/if}} {{#if disabled}}input-wrapper_disabled{{/if}}">
    <input
            type="{{type}}"
            id="{{id}}"
            value="{{value}}"
            placeholder="{{placeholder}}"
            class="input-field"
        {{#if required}}required{{/if}}
        {{#if pattern}}pattern="{{pattern}}"{{/if}}
        {{#if minlength}}minlength="{{minlength}}"{{/if}}
        {{#if maxlength}}maxlength="{{maxlength}}"{{/if}}
    />

    {{#if error}}
        <span class="input-error-message">{{error}}</span>
    {{/if}}

<!--    {{#if hint}}-->
<!--        <span class="input-hint">{{hint}}</span>-->
<!--    {{/if}}-->
</div>